<Window x:Class="Hushwire.App.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Hushwire" Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" UseLayoutRounding="True">
  <StackPanel Margin="28,26,28,22">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Image Source="pack://application:,,,/Assets/hushwire.ico" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="StepTitle" Style="{StaticResource H1}"/>
        <TextBlock x:Name="StepCount" Style="{StaticResource MutedText}" FontSize="12"/>
      </StackPanel>
    </StackPanel>

    <!-- 1 -->
    <StackPanel x:Name="Step1">
      <TextBlock TextWrapping="Wrap" LineHeight="21" Text="Hushwire blocks ads, trackers and known-bad sites for every program on this PC by answering their DNS lookups itself."/>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
        <StackPanel>
          <TextBlock Text="Private by design" Style="{StaticResource H2}"/>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Text="No account. No data collected or sent anywhere. Your settings and statistics stay on this PC."/>
          <TextBlock Text="What it changes" Style="{StaticResource H2}" Margin="0,14,0,10"/>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Text="While protection is on, your network adapters use Hushwire for DNS. Your original settings are saved first and put back when you turn it off, exit, or if anything goes wrong."/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 2 -->
    <StackPanel x:Name="Step2" Visibility="Collapsed">
      <TextBlock Text="Protection level" Style="{StaticResource H2}"/>
      <StackPanel x:Name="LevelPanel"/>
      <TextBlock Text="Extras" Style="{StaticResource H2}" Margin="0,16,0,6"/>
      <CheckBox x:Name="NotifyBox" Content="Show a Windows notification when something needs attention" IsChecked="True"/>
      <CheckBox x:Name="HotkeyBox" Content="Press Ctrl+Alt+H anywhere to pause or resume protection" IsChecked="True"/>
    </StackPanel>

    <!-- 3 -->
    <StackPanel x:Name="Step3" Visibility="Collapsed">
      <TextBlock x:Name="Step3Text" TextWrapping="Wrap" LineHeight="21" Text="Turn protection on now. Hushwire then checks that it is really working."/>
      <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="ResultTitle" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="ResultText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <DockPanel Margin="0,22,0,0">
      <Button x:Name="SkipBtn" Content="Skip" Style="{StaticResource Btn}" DockPanel.Dock="Left" Click="Skip_Click"/>
      <Button x:Name="NextBtn" Content="Next" Style="{StaticResource Primary}" DockPanel.Dock="Right" MinWidth="120" Click="Next_Click"/>
      <Button x:Name="BackBtn" Content="Back" Style="{StaticResource Btn}" DockPanel.Dock="Right" Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
      <Grid/>
    </DockPanel>
  </StackPanel>
</Window>
